---
import type { CollectionEntry } from "astro:content";
import type { GetStaticPaths } from "astro";
import {
  getUrlForCollectionEntry,
  getReading,
  getReadingParentName,
} from "src/content/config";
import { authorToSlug } from "src/utils";
import Base from "@layouts/Base.astro";
import Article from "src/components/Article.astro";
import PostContent from "src/components/blog/post/PostContent.astro";
import Pagination from "src/components/blog/post/Pagination.astro";
import Stars from "src/components/reading/Stars.astro";

export const getStaticPaths: GetStaticPaths = async () => {
  const posts = await getReading();
  const paths = posts
    .filter((entry) => {
      return entry.body && entry.body.trim().length > 0;
    })
    .map((entry) => ({
      params: { post: entry.slug },
      props: { entry },
    }));
  return paths;
};

type Props = { entry: CollectionEntry<"reading"> };

const {
  entry,
  entry: { data: frontmatter, render },
} = Astro.props;

const basename = entry.id.split("/").pop() || "";
const { Content } = await render();

// Check if the author or collection has multiple books (parent page exists)
const allBooks = await getReading();
const parent = frontmatter.parent;
const attribution = getReadingParentName(parent);
const parentBookCount = allBooks.filter(
  (book) => getReadingParentName(book.data.parent) === attribution
).length;
const parentUrl =
  parentBookCount > 1
    ? `/reading/author/${authorToSlug(attribution)}`
    : null;
const attributionPrefix = parent.type === "collection" ? "" : "by ";
const publishYear =
  frontmatter.publishYear === "Unknown" ? null : frontmatter.publishYear;
---

<Base
  path={"reading/" + basename}
  back="/reading"
  title={frontmatter.title}
  description={`${frontmatter.title} ${attributionPrefix}${attribution}${publishYear === null ? "" : ` (${publishYear})`}`}
  card={true}
>
  <Article>
    <div class="post-header">
      <div>
        <h1>
          {frontmatter.title}
        </h1>
        <h2>
          {attributionPrefix}
          {
            parentUrl ? (
              <a href={parentUrl}>{attribution}</a>
            ) : (
              attribution
            )
          }
          {publishYear !== null && <span id="year">({publishYear})</span>}
        </h2>
      </div>
      <div class="metadata">
        <h1 id="rating">
          <Stars rating={frontmatter.rating} />
        </h1>
        <!-- <p id="genre">
          {frontmatter.genre.map((g) => <span class="tag">#{g}</span>)}
        </p> -->
      </div>
    </div>
    <PostContent>
      <Content />
    </PostContent>
    <Pagination
      currentId={entry.id}
      itemLabel="Book"
      getEntries={() =>
        getReading(
          (entry) => (entry.body && entry.body.trim().length > 0) || false
        ).then((posts) =>
          posts.map((p) => ({
            slug: p.slug,
            id: p.id,
            title: p.data.title,
            url: getUrlForCollectionEntry("reading", p.slug),
          }))
        )}
    />
  </Article>
</Base>

<style>
  .post-header {
    margin-bottom: 1rem;
    display: flex;
    justify-content: space-between;
    align-items: baseline;
  }

  #rating {
    color: var(--accent-color);
  }
  h1,
  h2 {
    font-family: var(--font-sans-serif);
  }

  h1 {
    margin-bottom: 0;
  }
  h2 {
    opacity: var(--dimmed-opacity);
    font-weight: 400;
    margin-top: 0.2rem;
    font-size: 1.1rem;
  }

  .genres {
    opacity: var(--dimmed-opacity);
    display: flex;
    flex-wrap: wrap;
    gap: 0.5em;
    margin-top: 0.5em;
    .tag {
      margin-right: 0.5em;
    }
  }
</style>
