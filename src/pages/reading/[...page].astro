---
import type { CollectionEntry } from "astro:content";
import type { GetStaticPaths, Page } from "astro";
import { getReading, getReadingParentName } from "src/content/config";
import Base from "@layouts/Base.astro";
import ReadingList from "src/components/reading/ReadingList.astro";
import Pagination from "src/components/Pagination.astro";
import Intro from "src/components/common/Intro.astro";

export const getStaticPaths: GetStaticPaths = async ({ paginate }) => {
  const posts = await getReading();
  return paginate(posts, { pageSize: 50 });
};

type Props = { page: Page<CollectionEntry<"reading">> };

const { page } = Astro.props;

// Get all books to determine which authors or collections have multiple books
const allBooks = await getReading();
const parentCounts = new Map<string, number>();
for (const book of allBooks) {
  const parent = getReadingParentName(book.data.parent);
  parentCounts.set(parent, (parentCounts.get(parent) || 0) + 1);
}
const parentsWithMultipleBooks = new Set(
  Array.from(parentCounts.entries())
    .filter(([_, count]) => count > 1)
    .map(([parent]) => parent)
);
---

<Base path="reading" title="Reading" description="Goodreads at home">
  <div class="container">
    <Intro title="Book Reviews" subtitle="Goodreads at home" />

    <section id="list">
      <ReadingList
        books={page.data}
        parentsWithMultipleBooks={parentsWithMultipleBooks}
      />
      <div class="pagination">
        <Pagination page={page} base="reading" />
      </div>
    </section>
  </div>
</Base>

<style>
  div.container {
    display: flex;
    flex-direction: column;
  }

  div.pagination {
    width: 100%;
    display: flex;
    justify-content: center;
  }
</style>
