---
import type { CollectionEntry } from "astro:content";
import type { GetStaticPaths } from "astro";
import { getReading, getReadingParentName } from "src/content/config";
import { authorToSlug } from "src/utils";
import Base from "@layouts/Base.astro";
import AuthorList from "src/components/reading/author/AuthorList.astro";
import Intro from "src/components/common/Intro.astro";

export const getStaticPaths: GetStaticPaths = async () => {
  const allBooks = await getReading();

  // Group books by author, falling back to collection when there is no author
  const parentMap = new Map<string, CollectionEntry<"reading">[]>();
  for (const book of allBooks) {
    const parent = getReadingParentName(book.data.parent);
    if (!parentMap.has(parent)) {
      parentMap.set(parent, []);
    }
    parentMap.get(parent)!.push(book);
  }

  // Filter to only parents with more than one book
  const parentsWithMultipleBooks = Array.from(parentMap.entries()).filter(
    ([_, books]) => books.length > 1
  );

  // Create paths for each author or collection
  return parentsWithMultipleBooks.map(([parentName, books]) => ({
    params: { author: authorToSlug(parentName) },
    props: { parentName, books },
  }));
};

type Props = {
  parentName: string;
  books: CollectionEntry<"reading">[];
};

const { parentName, books } = Astro.props;
---

<Base
  path={`reading/author/${authorToSlug(parentName)}`}
  title={`${parentName}`}
  description={`Books I've read: ${parentName}`}
  back="/reading"
>
  <div class="container">
    <Intro title="Book Reviews" subtitle={`For ${parentName}`} />

    <section id="list">
      <AuthorList books={books} />
    </section>
  </div>
</Base>

<style>
  div.container {
    display: flex;
    flex-direction: column;
  }
</style>
