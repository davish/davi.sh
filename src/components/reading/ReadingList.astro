---
import type { CollectionEntry } from "astro:content";
import { getReadingParentName } from "src/content/config";
import ReadingEntry from "src/components/reading/ReadingEntry.astro";

type Props = {
  books: CollectionEntry<"reading">[];
  parentsWithMultipleBooks?: Set<string>;
};

const { books, parentsWithMultipleBooks } = Astro.props;
---

<div class="book-list">
  {
    books.map((post) => (
      <ReadingEntry
        post={post}
        showParentLink={
          parentsWithMultipleBooks?.has(
            getReadingParentName(post.data.parent)
          ) || false
        }
      />
    ))
  }
</div>

<style>
  .book-list {
    width: 100%;
    display: grid;
    grid-template-columns: 1.5fr 1fr 10ch 6ch;
    gap: 0.5rem;
    padding: 0.75rem 0;

    @media (--phone) {
      grid-template-columns: 1fr 10ch;
    }
  }
</style>
